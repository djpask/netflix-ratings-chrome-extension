{
  "manifest_version": 3,
  "name": "FlixRatings - IMDb, Rotten Tomatoes & Metacritic per Netflix",
  "version": "0.6.0",
  "description": "Aggiunge i rating di IMDb, Rotten Tomatoes e Metacritic a tutti i film e le serie TV del feed Netflix, con gestione watchlist ed esportazione Google Keep.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "FlixRatings - Watchlist & Impostazioni"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://keep.google.com/*"
      ],
      "js": [
        "content/keep.js"
      ],
      "css": [
        "content/keep.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "https://v3.sg.media-imdb.com/*",
    "https://v3-cinemeta.strem.io/*",
    "https://www.omdbapi.com/*",
    "https://keep.google.com/*"
  ]
}
